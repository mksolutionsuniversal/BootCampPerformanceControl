<Window x:Class="BootCampPerformanceControl.UI.CompatibilityReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compatibility Report"
        Width="820"
        Height="640"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="No report is uploaded automatically."
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="Review the report below, copy or save it, then open a GitHub issue and paste the report into the issue body."
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <TextBlock Text="Suggested steps: 1. Click Copy Report. 2. Click Open GitHub Issue. 3. Paste the report into the issue."
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding GitHubIssueUrl}"
                       Foreground="#666666"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <TextBox Grid.Row="1"
                 Text="{Binding ReportText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12" />

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="#444444"
                   TextWrapping="Wrap"
                   Margin="0,10,0,10" />

        <DockPanel Grid.Row="3">
            <Button Content="Close"
                    IsCancel="True"
                    MinWidth="90"
                    Padding="16,7"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Copy Report"
                        Command="{Binding CopyReportCommand}"
                        MinWidth="110"
                        Padding="16,7"
                        Margin="0,0,8,0" />
                <Button Content="Save Report"
                        Command="{Binding SaveReportCommand}"
                        MinWidth="110"
                        Padding="16,7"
                        Margin="0,0,8,0" />
                <Button Content="Open GitHub Issue"
                        Command="{Binding OpenGitHubIssueCommand}"
                        MinWidth="150"
                        Padding="16,7" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
