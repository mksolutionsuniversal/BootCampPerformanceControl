<Window x:Class="BootCampPerformanceControl.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About BootCamp Performance Control"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="BootCamp Performance Control"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="VersionTextBlock"
                       FontSize="13"
                       Foreground="#666666"
                       Margin="0,2,0,12" />

            <TextBlock Text="MK Universal Solutions LTD - by Michal Kurzdym"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Open-source utility for Intel Macs running Windows through Boot Camp."
                       Style="{StaticResource BodyTextStyle}"
                       Margin="0,0,0,10" />

            <TextBlock Text="Contact:"
                       Style="{StaticResource SectionHeadingStyle}" />
            <TextBlock Text="info@mkus.co.uk"
                       Style="{StaticResource BodyTextStyle}" />

            <TextBlock Text="Performance-validated model:"
                       Style="{StaticResource SectionHeadingStyle}" />
            <TextBlock Text="MacBookPro16,1"
                       Style="{StaticResource BodyTextStyle}" />

            <TextBlock Text="Fan control:"
                       Style="{StaticResource SectionHeadingStyle}" />
            <TextBlock Text="Not included in version 0.2.0"
                       Style="{StaticResource BodyTextStyle}"
                       Margin="0,0,0,16" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button Content="Close"
                    Click="OnCloseClick"
                    IsDefault="True"
                    IsCancel="True"
                    MinWidth="90"
                    Padding="16,6"
                    HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
