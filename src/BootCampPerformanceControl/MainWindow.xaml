<Window x:Class="BootCampPerformanceControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BootCamp Performance Control"
        Icon="Assets/AppIcon.ico"
        Height="700"
        Width="940"
        MinHeight="580"
        MinWidth="760">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,16,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="BootCamp Performance Control"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ApplicationVersion, StringFormat=Version {0}}"
                           Foreground="#666666"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="Export Diagnostic Report"
                        Command="{Binding ExportDiagnosticReportCommand}"
                        MinWidth="190"
                        Padding="16,8"
                        Margin="0,0,8,0" />
                <Button Content="Report Compatibility Issue"
                        Command="{Binding ReportCompatibilityIssueCommand}"
                        MinWidth="190"
                        Padding="16,8"
                        Margin="0,0,8,0" />
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        MinWidth="110"
                        Padding="16,8"
                        Margin="0,0,8,0" />
                <Button Content="About"
                        Click="OnAboutClick"
                        MinWidth="90"
                        Padding="16,8" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                <GroupBox Header="Hardware">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Mac model" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding MacModel}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="CPU" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding Cpu}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Core/thread count" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding CoreThreadCount}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="GPU" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding Gpu}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Windows version" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding WindowsVersion}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Compatibility">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Platform support" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding PlatformSupport}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Model validation" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ModelValidation}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Details" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding CompatibilityDetails}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Power">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Active scheme GUID" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ActivePowerScheme}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Detected profile state" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding DetectedProfileState}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Restore snapshot" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding RestoreSnapshotStatus}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="CPU Maximum AC" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ProcessorMaximumAc}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="CPU Maximum DC" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ProcessorMaximumDc}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Turbo/Boost AC" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding BoostModeAc}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Turbo/Boost DC" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding BoostModeDc}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Profiles">
                    <ItemsControl ItemsSource="{Binding ProfileButtons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}"
                                        Command="{Binding Command}"
                                        IsEnabled="{Binding IsEnabled}"
                                        ToolTip="{Binding ToolTip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        MinHeight="36"
                                        Margin="4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <GroupBox Header="Fan Control">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="AppleSMC backend" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding FanStatus.BackendDisplayText}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Safety status" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding FanStatus.SafetyDisplayText}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Fan 0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding FanStatus.Fan0DisplayText}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Fan 1" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding FanStatus.Fan1DisplayText}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Mode" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding FanStatus.ModeDisplayText}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Write control" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding FanStatus.WriteControlDisplayText}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Details" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding FanStatus.Details}" />

                        <Button Grid.Row="7"
                                Grid.Column="1"
                                Content="Enable Fan Monitoring"
                                Command="{Binding EnableFanMonitoringCommand}"
                                Visibility="{Binding IsFanMonitoringActivationAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                HorizontalAlignment="Left"
                                MinWidth="190"
                                Padding="16,8"
                                Margin="0,4,0,0" />
                    </Grid>
                </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Options">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <GroupBox Header="Window close behavior">
                            <StackPanel Margin="4">
                                <TextBlock Text="Choose what happens when you click the X button."
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />
                                <RadioButton Content="Keep the application running in the system tray"
                                             GroupName="CloseBehavior"
                                             IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,8" />
                                <TextBlock Text="Fan monitoring remains active. Double-click the tray icon to restore the window, or choose Exit from its menu."
                                           Foreground="#666666"
                                           TextWrapping="Wrap"
                                           Margin="24,0,0,14" />
                                <RadioButton Content="Exit the application completely"
                                             GroupName="CloseBehavior"
                                             IsChecked="{Binding ExitApplicationOnClose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Windows startup">
                            <StackPanel Margin="4">
                                <CheckBox Content="Start BootCamp Performance Control when I sign in to Windows"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,8" />
                                <TextBlock Text="This uses the current-user Windows startup entry and does not require administrator rights."
                                           Foreground="#666666"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Startup appearance">
                            <StackPanel Margin="4">
                                <CheckBox Content="Start minimized to the system tray"
                                          IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,8" />
                                <TextBlock Text="This applies to normal application launches and is independent from Start With Windows."
                                           Foreground="#666666"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="0,8,0,0"
                   Foreground="#444444" />
    </Grid>
</Window>
