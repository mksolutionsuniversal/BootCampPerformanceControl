<Window x:Class="BootCampPerformanceControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BootCamp Performance Control"
        Height="700"
        Width="940"
        MinHeight="580"
        MinWidth="760">
    <Window.Resources>
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,16,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    MinWidth="110"
                    Padding="16,8" />
            <StackPanel>
                <TextBlock Text="BootCamp Performance Control"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ReadOnlyMessage}"
                           FontWeight="SemiBold"
                           Foreground="#8A3A0A"
                           Margin="0,4,0,0" />
                <TextBlock Text="{Binding ApplicationVersion, StringFormat=Version {0}}"
                           Foreground="#666666"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Hardware">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Mac model" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding MacModel}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="CPU" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding Cpu}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Core/thread count" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding CoreThreadCount}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="GPU" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding Gpu}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Windows version" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding WindowsVersion}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Compatibility">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Verified model" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding VerifiedModel}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Details" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding CompatibilityDetails}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Power">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Active scheme GUID" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ActivePowerScheme}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="CPU Maximum AC" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ProcessorMaximumAc}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="CPU Maximum DC" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ProcessorMaximumDc}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Turbo/Boost AC" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding BoostModeAc}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="Turbo/Boost DC" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding BoostModeDc}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Profiles">
                    <ItemsControl ItemsSource="{Binding ProfileButtons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}"
                                        Command="{Binding Command}"
                                        IsEnabled="{Binding IsEnabled}"
                                        ToolTip="{Binding ToolTip}"
                                        ToolTipService.ShowOnDisabled="True"
                                        MinHeight="36"
                                        Margin="0,0,8,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <GroupBox Header="Fan Control">
                    <TextBlock Text="{Binding FanControlStatus}"
                               Style="{StaticResource ValueTextStyle}"
                               Margin="4" />
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="0,8,0,0"
                   Foreground="#444444" />
    </Grid>
</Window>
