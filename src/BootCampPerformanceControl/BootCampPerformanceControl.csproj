<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>BootCamp Performance Control</AssemblyTitle>
    <Product>BootCamp Performance Control</Product>
    <Company>MK Universal Solutions LTD</Company>
    <Authors>MK Universal Solutions LTD</Authors>
    <Copyright>Copyright © 2026 MK Universal Solutions LTD</Copyright>
    <Description>Open-source Windows utility for Intel Macs running Windows through Boot Camp, providing safe processor power management and verified Apple SMC fan control on explicitly validated hardware.</Description>
    <RepositoryType>git</RepositoryType>
    <PackageTags>bootcamp;windows;macbook;power-management;fan-control;apple-smc</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

</Project>
